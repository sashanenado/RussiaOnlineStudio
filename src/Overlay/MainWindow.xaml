<Window x:Class="RussiaOnlineOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Russia Online — Overlay"
 Width="500" Height="320" MinWidth="460" MinHeight="300"
 WindowStartupLocation="CenterScreen"
 Background="#0D1117" Foreground="#E8EDF3" ResizeMode="NoResize">
 <Grid Margin="18">
  <Border Background="#151C25" BorderBrush="#303D4B" BorderThickness="1"
   CornerRadius="16" Padding="20">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
     <Border DockPanel.Dock="Left" Background="#352D21" CornerRadius="9"
      Padding="10" Margin="0,0,12,0" VerticalAlignment="Top">
      <TextBlock Text="RO" Foreground="#E5C58F" FontSize="18" FontWeight="Bold"/>
     </Border>
     <StackPanel>
      <TextBlock Text="RUSSIA ONLINE / OVERLAY" FontSize="18"
       FontWeight="Bold" Foreground="#E5C58F"/>
      <TextBlock Text="Панель управления игровыми памятками"
       Foreground="#9AA8B7" Margin="0,4,0,0"/>
     </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1">
     <Border Background="#101720" BorderBrush="#2A3745" BorderThickness="1"
      CornerRadius="10" Padding="12" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="СОСТОЯНИЕ" Foreground="#7F91A4" FontSize="10"
        FontWeight="Bold" Margin="0,0,0,5"/>
       <TextBlock x:Name="Status" Text="Загрузка панелей..."
        TextWrapping="Wrap" Foreground="#DDE5ED" FontSize="13"/>
      </StackPanel>
     </Border>
     <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Foreground="#D5B47E"
      FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
     <UniformGrid Columns="2" Rows="2">
      <TextBlock Text="F8   Выход" Foreground="#CBD4DE" Margin="2,3"/>
      <TextBlock Text="F9   Все окна" Foreground="#CBD4DE" Margin="2,3"/>
      <TextBlock Text="F10  Управление" Foreground="#CBD4DE" Margin="2,3"/>
      <TextBlock Text="F11  Перемещение" Foreground="#CBD4DE" Margin="2,3"/>
     </UniformGrid>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal"
     HorizontalAlignment="Right" Margin="0,14,0,0">
     <Button Content="Показать все" Click="Show_Click"/>
     <Button Content="Скрыть все" Click="Hide_Click"/>
     <Button Content="Выйти" Foreground="#F0A3A3" Click="Exit_Click"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>