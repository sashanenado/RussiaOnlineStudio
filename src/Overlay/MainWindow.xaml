<Window x:Class="RussiaOnlineOverlay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Russia Online Overlay Control" Width="440" Height="260" WindowStartupLocation="CenterScreen" Background="#151B22" Foreground="#EDF1F5" ResizeMode="NoResize">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="RUSSIA ONLINE / OVERLAY" FontSize="18" FontWeight="Bold" Foreground="#C9A66B"/><TextBlock Text="Управление независимыми окнами памятки" Foreground="#9AA7B5" Margin="0,3,0,12"/></StackPanel><StackPanel Grid.Row="1"><TextBlock x:Name="Status" Text="Загрузка панелей..." TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="F8 — выход · F9 — все окна · F10 — панель · F11 — перемещение" Foreground="#9AA7B5" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Показать все" Click="Show_Click"/><Button Content="Скрыть все" Click="Hide_Click"/><Button Content="Закрыть Overlay" Click="Exit_Click"/></StackPanel></Grid></Window>