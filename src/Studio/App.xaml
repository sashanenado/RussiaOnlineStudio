<Application x:Class="RussiaOnlineStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0D1117"/>
  <SolidColorBrush x:Key="Panel" Color="#151C25"/>
  <SolidColorBrush x:Key="Line" Color="#2A3542"/>
  <SolidColorBrush x:Key="Gold" Color="#B99660"/>
  <SolidColorBrush x:Key="Text" Color="#E8EDF3"/>
  <Style TargetType="{x:Type Button}">
   <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#202B37"/>
   <Setter Property="BorderBrush" Value="#364453"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#C9A66B"/><Setter TargetName="Bd" Property="Background" Value="#2B3744"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A3023"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type TextBox}">
   <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#0F151C"/>
   <Setter Property="BorderBrush" Value="#303B48"/><Setter Property="CaretBrush" Value="#E8EDF3"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#C9A66B"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
   <Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Foreground" Value="#E8EDF3"/><Setter Property="Background" Value="#1A232D"/>
   <Setter Property="BorderBrush" Value="#394756"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
   <Setter Property="Foreground" Value="#E8EDF3"/><Setter Property="Background" Value="#1A232D"/>
   <Setter Property="Padding" Value="9,7"/>
   <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#344253"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#453A28"/><Setter Property="Foreground" Value="#F3D7A8"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type CheckBox}">
   <Setter Property="Foreground" Value="#E8EDF3"/><Setter Property="Margin" Value="4,5"/>
  </Style>
  <Style TargetType="{x:Type ListBox}">
   <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#2D3947"/><Setter Property="Background" Value="#10161D"/>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
   <Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="2"/>
   <Setter Property="Foreground" Value="#E8EDF3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ListBoxItem}">
    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#30302B"/><Setter TargetName="Bd" Property="BorderBrush" Value="#B99660"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#202B37"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type RichTextBox}">
   <Setter Property="Foreground" Value="#E8EDF3"/><Setter Property="CaretBrush" Value="#E8EDF3"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
 </Application.Resources>
</Application>