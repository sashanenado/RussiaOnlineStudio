<Window x:Class="RussiaOnlineStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Russia Online Studio" Width="1280" Height="820" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#101419" Foreground="#ECF0F4">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#19212A" BorderBrush="#303B48" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
 <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="RUSSIA ONLINE  /  STUDIO" FontSize="19" FontWeight="Bold" Foreground="#C9A66B"/><TextBlock Text="Рабочая мастерская семьи • локальные данные" Foreground="#9AA7B5" FontSize="12"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Профиль" VerticalAlignment="Center" Margin="8"/><ComboBox x:Name="ProfileBox" Width="180" SelectionChanged="ProfileBox_SelectionChanged"><ComboBoxItem Content="Основной"/><ComboBoxItem Content="Заместитель"/><ComboBoxItem Content="Личный"/></ComboBox><Button Content="Открыть папку данных" Click="OpenData_Click"/></StackPanel></DockPanel>
</Border>
<TabControl x:Name="MainTabs" Grid.Row="1" Background="#151B22" BorderBrush="#303B48">
<TabControl.Resources>
  <Style TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="#DCE3EA"/>
    <Setter Property="Background" Value="#19212A"/>
    <Setter Property="BorderBrush" Value="#303B48"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="FontSize" Value="13"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="#F4D9A5"/>
        <Setter Property="Background" Value="#29251F"/>
        <Setter Property="BorderBrush" Value="#C9A66B"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#25303B"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</TabControl.Resources>
<TabItem Header="Обзор"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="Добро пожаловать в Studio" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Добавляй статьи в библиотеку — отдельная памятка законов Overlay обновится автоматически после сохранения." Foreground="#9AA7B5" Margin="0,0,0,20"/><UniformGrid Columns="3"><Border Background="#19212A" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="СТАТЬИ" Foreground="#9AA7B5"/><TextBlock x:Name="StatLaws" Text="0" FontSize="32" Foreground="#C9A66B" FontWeight="Bold"/></StackPanel></Border><Border Background="#19212A" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="ПАНЕЛИ" Foreground="#9AA7B5"/><TextBlock x:Name="StatPanels" Text="0" FontSize="32" Foreground="#C9A66B" FontWeight="Bold"/></StackPanel></Border><Border Background="#19212A" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="ПРОФИЛЬ" Foreground="#9AA7B5"/><TextBlock x:Name="StatProfile" Text="Основной" FontSize="22" Foreground="#C9A66B" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Border Background="#24251F" BorderBrush="#685A3C" BorderThickness="1" CornerRadius="9" Padding="14" Margin="5,18"><TextBlock TextWrapping="Wrap" Text="Studio сохраняет изменения в Data. Overlay читает panels.json из той же папки. Для передачи всей семьи скопируй папку RussiaOnline вместе с двумя EXE и Data. Сначала сделай резервную копию старых JSON." Foreground="#E7D7B8"/></Border><StackPanel Orientation="Horizontal"><Button Content="Перейти к законам" Click="GoLaws_Click"/><Button Content="Конструктор панелей" Click="GoPanels_Click"/><Button Content="Сохранить всё" Background="#C9A66B" Foreground="#141414" Click="SaveAll_Click"/></StackPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Библиотека законов"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ComboBox x:Name="CategoryBox" Grid.Row="0" SelectionChanged="CategoryBox_SelectionChanged"/><TextBox x:Name="SearchBox" Grid.Row="1" ToolTip="Поиск" TextChanged="SearchBox_TextChanged"/><ListBox x:Name="LawList" Grid.Row="2" Background="#10161D" Foreground="#ECF0F4" BorderBrush="#303B48" SelectionChanged="LawList_SelectionChanged" DisplayMemberPath="Display"/><Button Grid.Row="3" Content="＋ Добавить статью" Click="AddLaw_Click"/>
</Grid><ScrollViewer Grid.Column="1" Margin="16,0,0,0"><StackPanel><TextBlock Text="Редактор статьи" FontSize="20" FontWeight="Bold" Margin="3,0,3,12"/><TextBlock Text="Категория" Foreground="#9AA7B5"/><ComboBox x:Name="EditCategory"/><TextBlock Text="Номер статьи" Foreground="#9AA7B5"/><TextBox x:Name="EditNumber" TextChanged="LawEditor_TextChanged"/><TextBlock Text="Название" Foreground="#9AA7B5"/><TextBox x:Name="EditTitle" TextChanged="LawEditor_TextChanged"/><TextBlock Text="Полный текст" Foreground="#9AA7B5"/><TextBox x:Name="EditText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260" VerticalScrollBarVisibility="Auto" TextChanged="LawEditor_TextChanged"/><TextBlock Text="Заметка / комментарий" Foreground="#9AA7B5"/><TextBox x:Name="EditNote" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" TextChanged="LawEditor_TextChanged"/><CheckBox x:Name="EditFavorite" Content="В избранном" Margin="5" Foreground="#ECF0F4"/><StackPanel Orientation="Horizontal"><Button Content="Сохранить статью" Background="#C9A66B" Foreground="#141414" Click="SaveLaw_Click"/><Button Content="Копировать текст" Click="CopyLaw_Click"/><Button Content="Удалить" Foreground="#FFAAAA" Click="DeleteLaw_Click"/></StackPanel></StackPanel></ScrollViewer></Grid></TabItem>
<TabItem Header="Конструктор панелей"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Bottom" Content="＋ Новая панель" Click="AddPanel_Click"/><ListBox x:Name="PanelList" Background="#10161D" Foreground="#ECF0F4" DisplayMemberPath="Title" SelectionChanged="PanelList_SelectionChanged"/></DockPanel><ScrollViewer Grid.Column="1" Margin="12,0"><StackPanel><TextBlock Text="Параметры панели" FontSize="20" FontWeight="Bold"/><TextBlock Text="Название" Foreground="#9AA7B5"/><TextBox x:Name="PanelTitle" TextChanged="PanelEditor_TextChanged"/><TextBlock Text="Содержимое" Foreground="#9AA7B5"/><TextBox x:Name="PanelBody" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" VerticalScrollBarVisibility="Auto" TextChanged="PanelEditor_TextChanged"/><TextBlock Text="Ширина" Foreground="#9AA7B5"/><TextBox x:Name="PanelWidth" Text="360" TextChanged="PanelEditor_TextChanged"/><TextBlock Text="Масштаб шрифта" Foreground="#9AA7B5"/><TextBox x:Name="PanelScale" Text="1.0" TextChanged="PanelEditor_TextChanged"/><CheckBox x:Name="PanelVisible" Content="Показывать в Overlay" Margin="5"/><StackPanel Orientation="Horizontal"><Button Content="Сохранить панель" Background="#C9A66B" Foreground="#141414" Click="SavePanel_Click"/><Button Content="Удалить" Foreground="#FFAAAA" Click="DeletePanel_Click"/></StackPanel></StackPanel></ScrollViewer><Border Grid.Column="2" Background="#080B0F" BorderBrush="#46515F" BorderThickness="1" CornerRadius="10" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ПРЕДПРОСМОТР" Foreground="#C9A66B" FontWeight="Bold" Margin="0,0,0,12"/><ScrollViewer><TextBlock x:Name="PanelPreview" TextWrapping="Wrap" FontSize="15" Foreground="#ECF0F4"/></ScrollViewer></DockPanel></Border></Grid></TabItem>
<TabItem Header="Настройки"><StackPanel Margin="22" MaxWidth="700" HorizontalAlignment="Left"><TextBlock Text="Настройки отображения" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/><TextBlock Text="Масштаб интерфейса (%)" Foreground="#9AA7B5"/><TextBox x:Name="UiScale" Text="125"/><TextBlock Text="Масштаб игрового шрифта (legacy 0.6)" Foreground="#9AA7B5"/><TextBox x:Name="GameScale" Text="0.6"/><TextBlock Text="Горячие клавиши Overlay" Foreground="#9AA7B5" Margin="0,15,0,3"/><TextBlock Text="F8 — выход   F9 — показать/скрыть   F10 — панель управления   F11 — режим перемещения" TextWrapping="Wrap"/><TextBlock Text="Папка данных" Foreground="#9AA7B5" Margin="0,18,0,3"/><TextBlock x:Name="DataPath" TextWrapping="Wrap"/><Button Content="Сохранить настройки" HorizontalAlignment="Left" Background="#C9A66B" Foreground="#141414" Click="SaveSettings_Click"/></StackPanel></TabItem>
</TabControl>
<TextBlock Grid.Row="2" x:Name="StatusText" Text="Готово" Foreground="#9AA7B5" Margin="5,10,5,0"/>
</Grid></Window>